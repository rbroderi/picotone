# Build output
target/
node_modules/
web/dist/
web/public/build/
# The wasm builds and the compiled TypeScript API: `powershell -File wasm\build.ps1`
# (or `npm run build:ts` in wasm/ for the .js/.d.ts files alone).
wasm/www/picotone/

# The foobar2000 component: the downloaded SDK, the builds and package, test files
foobar/sdk/
foobar/build/
foobar/testfiles/
# FFmpeg with libpicotone: `ffmpeg/build.sh linux|windows`
ffmpeg/dist/

# Large or downloaded data (re-created by the tools; see the READMEs)
work/
web/public/models/
wasm/www/models/
train/**/*.npz
train/**/*.pt
train/**/*.ckpt
# HQ training: runs, exports and the corpus manifests (made by prep_*.py)
train/hq/runs/
train/hq/export/
train/hq/pf_lowtier/
train/hq/weights/
train/hq/data/*.jsonl
train/hq/data/*.jsonl.*
# Scratch audio, and the sample song's original (samples/README.md)
*.wav
samples/*.flac

# Python
.venv/
__pycache__/
