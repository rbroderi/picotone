# Build output
target/
node_modules/
web/dist/
web/public/build/
# The wasm builds and the compiled TypeScript API: `powershell -File wasm\build.ps1`
# (or `npm run build:ts` in wasm/ for the .js/.d.ts files alone).
wasm/www/picotone/

# Large or downloaded data (re-created by the tools; see the READMEs)
work/
dwp/out/
dwp/cache/
web/public/models/
wasm/www/models/
train/**/*.npz
train/**/*.pt
train/**/*.ckpt
# DAC distillation: training runs, exports and the corpus manifests (made by prep_*.py)
distill/runs/
distill/export/
distill/data/*.jsonl
distill/data/*.jsonl.*
# The Vocos HQ decoder: random-init stand-ins (tools/vocos_fixture.py) until
# the trained export is converted by tools/export_vocos.py
weights/dac44_vocos.*
# The trained HQ encoder (src/stftenc.rs), converted by tools/export_stftenc.py
weights/dac44_stftenc.*

# Scratch audio
*.wav

# Python
.venv/
__pycache__/
