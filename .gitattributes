# Text files are stored with LF line endings in the repository.
* text=auto eol=lf

# The cx2 tables are hashed into every stream, so their bytes must never be changed.
*.ecxm binary
*.pico binary
*.picol binary
*.opus binary
*.wasm binary
*.ps1 text eol=crlf

# Model weights are stored with Git LFS: Meta's EnCodec (MIT; weights/EnCodec-MIT.txt), DAC 44 kHz's
# weights (MIT; weights/DAC-MIT.txt) and our HQ encoder and decoder trained from them
# (weights/dac44_stftenc.NOTICE.txt, weights/dac44_quantizer.NOTICE.txt, weights/dac44_vocos.NOTICE.txt).
weights/*.safetensors filter=lfs diff=lfs merge=lfs -text
